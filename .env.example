# Local quick start uses SQLite (no database server installation required).
# For PostgreSQL, set DATABASE_URL=postgresql+psycopg://portfolio:YOUR_PASSWORD@localhost:5432/portfolio
DATABASE_URL=sqlite:///./portfolio.db
ADMIN_EMAIL=priyanshu-admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
